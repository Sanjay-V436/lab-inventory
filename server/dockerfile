# Use Node 20
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Copy package files first (for caching)
COPY package*.json ./

# Install dependencies
RUN npm install --production

# Copy rest of the code
COPY . .

# Create uploads directory so Multer can write to it
RUN mkdir -p uploads

# Expose port
EXPOSE 5000

# Start the server
CMD ["node", "index.js"]